# Copia este archivo a ".env" en el servidor y completa los valores reales.
# Nunca subas el ".env" real a git (ya está en .gitignore).

DB_PASSWORD=elige_una_password_larga_y_segura
JWT_SECRET=genera_un_texto_aleatorio_largo_aqui
FRONTEND_URL=https://intranet.therateam.com
# Dominio(s) desde donde el navegador puede llamar a la API — separados por coma si son varios.
CORS_ALLOWED_ORIGINS=https://intranet.therateam.com

# Opcional — correo para "recuperar contraseña". Si se dejan vacíos, el sistema
# solo registra el correo en el log en vez de enviarlo (útil mientras no lo configures).
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
